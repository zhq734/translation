{
  "name": "selection-translator",
  "version": "0.1.0",
  "description": "划词翻译 - macOS、Windows 与 Linux 桌面全局划词翻译工具（选区按钮与常驻弹窗）",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:dmg": "npm run build && electron-builder --mac dmg --x64 --arm64",
    "test": "node scripts/run-tests.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --arm64",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.selection.translator",
    "productName": "划词翻译",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/uiohook-napi/**/*",
      "build/tray*.png"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "SelectionTranslator-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "划词翻译"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "划词翻译",
      "artifactName": "SelectionTranslator-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "SelectionTranslator-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
