{
  "name": "selection-translator",
  "version": "0.1.0",
  "description": "划词翻译 - macOS、Windows 与 Linux 桌面全局划词翻译工具（选区按钮与常驻弹窗）",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-macos-vision-ocr.mjs && node scripts/generate-build-info.mjs --output build/build-info.json --allow-local-fallback && electron-vite dev",
    "dev:notify-test": "node --experimental-strip-types scripts/test-install-notification.mts",
    "build": "node scripts/build-macos-vision-ocr.mjs && node scripts/generate-build-info.mjs --output build/build-info.json --allow-local-fallback && node scripts/generate-usage-report-config.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:mac:ci": "npm run build && electron-builder --mac --x64 --arm64 --publish never --config.forceCodeSigning=true",
    "dist:mac:unsigned": "npm run build && electron-builder --mac --x64 --arm64 --publish never --config.forceCodeSigning=false --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "dist:mac:x64:ci": "npm run build && electron-builder --mac --x64 --publish never --config.forceCodeSigning=true",
    "dist:mac:x64:unsigned": "npm run build && electron-builder --mac --x64 --publish never --config.forceCodeSigning=false --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "dist:mac:arm64:ci": "npm run build && electron-builder --mac --arm64 --publish never --config.forceCodeSigning=true",
    "dist:mac:arm64:unsigned": "npm run build && electron-builder --mac --arm64 --publish never --config.forceCodeSigning=false --config.mac.identity=- --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "dist:dmg": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "test": "node scripts/run-tests.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --arm64 --publish never",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.selection.translator",
    "productName": "划词翻译",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhq734",
        "repo": "translation"
      }
    ],
    "files": [
      "out/**/*",
      "assets/ocr/**/*",
      "node_modules/@gutenye/**/*",
      "node_modules/@techstark/**/*",
      "node_modules/@img/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/uiohook-napi/**/*",
      "build/usage-report-config.json",
      "build/tray*.png"
    ],
    "asarUnpack": [
      "assets/ocr/**/*",
      "node_modules/@gutenye/**/*",
      "node_modules/@gutenye/ocr-models/assets/**/*",
      "node_modules/@img/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "SelectionTranslator-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "build/macos-vision-ocr",
          "to": "macos-vision-ocr"
        },
        {
          "from": "build/build-info.json",
          "to": "build-info.json"
        }
      ]
    },
    "dmg": {
      "title": "划词翻译"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "app-icon.ico"
        },
        {
          "from": "build/build-info.json",
          "to": "build-info.json"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "划词翻译",
      "include": "build/installer.nsh",
      "artifactName": "SelectionTranslator-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "build/build-info.json",
          "to": "build-info.json"
        }
      ],
      "artifactName": "SelectionTranslator-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "electron-updater": "^6.8.9",
    "nodemailer": "^9.0.6",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5",
    "undici": "^6.28.0"
  }
}
